{
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?route=prm" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/oauth?route=prm" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?route=asm" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/oauth?route=asm" },
    { "source": "/oauth/:route(register|authorize|callback|token)", "destination": "/api/oauth?route=:route" }
  ]
}
