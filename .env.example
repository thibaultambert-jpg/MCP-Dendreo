# Identifiant de l'instance : https://pro.dendreo.com/<DENDREO_SLUG>/api/
DENDREO_SLUG=
# Clé API Dendreo (Paramètres > API dans Dendreo)
DENDREO_API_KEY=

# --- Authentification Google Workspace (voir README, « Authentification ») ---
# Client OAuth Google de type « Application Web », URI de redirection : <PUBLIC_URL>/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails autorisés à utiliser le connecteur, séparés par des virgules
ALLOWED_EMAILS=prenom.nom@exemple.fr,autre.personne@exemple.fr
# Optionnel : n'accepter que les comptes de ce domaine Google Workspace
GOOGLE_WORKSPACE_DOMAIN=
# Secret de chiffrement des jetons, 32 caractères minimum (ex. : openssl rand -base64 48)
OAUTH_SECRET=
# Adresse publique du serveur (sans / final). Sur Vercel, déduite de l'URL de production si absente.
PUBLIC_URL=

# --- Stockage (fortement recommandé en production) ---
# Upstash Redis (Vercel > Storage > Upstash) : usage unique des codes, rotation des jetons, limitation de débit
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optionnel ---
# Requêtes MCP maximum par utilisateur et par minute (défaut 120)
# MCP_RATE_LIMIT=
# Origines web supplémentaires autorisées à appeler /api/mcp (claude.ai et claude.com le sont déjà)
# MCP_ALLOWED_ORIGINS=
# Remplace https://pro.dendreo.com/<slug>/api/ (tests)
# DENDREO_BASE_URL=
# 0 désactive la ligne de journal « mcp_outil » (taille des réponses par outil)
# MCP_MESURE=
